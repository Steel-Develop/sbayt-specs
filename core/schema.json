          },
          "title": "Row Ptr",
          "type": "array"
        }
      },
      "title": "DataFrameSeriesDTO",
      "type": "object"
    },
    "DataType": {
      "description": "Logical data types for DataFrame fields.",
      "enum": [
        "STRING",
        "INT",
        "LONG",
        "FLOAT",
        "DOUBLE",
        "BIG_DECIMAL",
        "BOOLEAN",
        "BYTES",
        "DATE",
        "TIME",
        "DATETIME",
        "DURATION",
        "UUID",
        "JSON",
        "ARRAY",
        "ANY",
        "UNKNOWN",
        "INFERRED"
