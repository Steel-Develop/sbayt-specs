    "DataFrameSchemaDTO": {
      "additionalProperties": false,
      "description": "DTO for DataFrameSchema.",
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/DataFrameFieldDTO"
          },
          "title": "Fields",
          "type": "array"
        },
        "indexes": {
          "items": {
            "$ref": "#/$defs/DataFrameIndexSpecDTO"
          },
          "title": "Indexes",
          "type": "array"
        }
      },
