      "type": "object",
      "description": "Error details exposed by shared Problem Details responses.",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        },
        "traceback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
