          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "field",
        "message",
        "message_key"
      ],
      "title": "FieldValidationErrorDTO",
      "type": "object"
    },
