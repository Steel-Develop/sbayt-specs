          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      }
    },
    "ValueRangeDTO": {
      "type": "object",
      "additionalProperties": false,
      "description": "Numeric or temporal range whose bounds retain the permissive Any wire type.",
      "properties": {
        "min": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hard lower bound."
        },
        "max": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hard upper bound."
        },
        "soft_min": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Soft lower bound."
        },
        "soft_max": {
          "anyOf": [
            {},
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Soft upper bound."
        },
        "inclusive": {
          "type": "boolean",
          "default": true,
          "description": "Whether comparisons include the boundaries."
        }
      }
    },
    "QuantityKind": {
      "type": "string",
      "description": "Physical quantity kinds aligned with the QUDT vocabulary.",
      "enum": [
        "temperature",
        "celsius_temperature",
        "pressure",
        "length",
        "mass",
        "velocity",
        "angular_velocity",
        "rotational_frequency",
        "power",
        "energy",
        "volume",
        "electric_current",
        "voltage",
        "resistance",
        "frequency",
        "byte_data_volume",
        "dimensionless",
        "time_duration",
        "plane_angle",
        "volumetric_flow_rate",
        "mass_flow_rate",
        "force",
        "torque",
        "linear_acceleration",
        "apparent_power",
        "reactive_power",
        "relative_humidity",
        "mass_density",
        "mass_concentration",
        "electric_conductivity",
        "dynamic_viscosity",
        "kinematic_viscosity",
        "irradiance",
        "illuminance",
        "sound_pressure_level",
        "ph",
        "turbidity"
      ]
    },
