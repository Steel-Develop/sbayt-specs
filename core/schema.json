      "additionalProperties": false,
      "description": "DTO for DataFrame.",
      "properties": {
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataFrameDataDTO"
            },
            {
              "$ref": "#/$defs/DataFrameDataCSRDTO"
            }
          ],
          "title": "Data"
        },
        "encoding": {
          "$ref": "#/$defs/DataFrameEncoding",
          "default": "row"
        },
        "meta": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataFrameMetaDTO"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/DataFrameSchemaDTO"
