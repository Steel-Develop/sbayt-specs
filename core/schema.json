    "DataFrameIndexSpecDTO": {
      "additionalProperties": false,
      "description": "DTO for DataFrameIndexSpec.",
      "properties": {
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "kind": {
          "default": "secondary",
          "enum": [
            "primary",
            "secondary"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "order": {
          "anyOf": [
            {
              "additionalProperties": {
                "enum": [
                  "asc",
                  "desc"
                ],
                "type": "string"
              },
              "type": "object"
            },
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "string"
                  },
                  {
                    "enum": [
                      "asc",
                      "desc"
                    ],
                    "type": "string"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Order"
        },
        "sparse": {
          "default": false,
          "title": "Sparse",
          "type": "boolean"
        },
        "unique": {
          "default": false,
          "title": "Unique",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "fields"
      ],
      "title": "DataFrameIndexSpecDTO",
      "type": "object"
    },
    "DataFrameMetaDTO": {
      "additionalProperties": false,
